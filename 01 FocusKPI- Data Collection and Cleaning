           - count: Number of reviews per batch (default: 100, max effective: 200)\n","            - filter_score_with: Filter by rating (default: None)\n","\n","    Returns:\n","        pandas.DataFrame containing the extracted reviews\n","    \"\"\"\n","    # Set default parameters\n","    default_params = {\n","        'lang': 'en',\n","        'country': 'us',\n","        'sort': Sort.MOST_RELEVANT,\n","        'count': 2000  # Default per documentation, max effective is 200\n","    }\n","\n","    # Update defaults with any provided kwargs\n","    params = {**default_params, **kwargs}\n","\n","    # Get the requested count\n","    requested_count = params.get('count', 100)\n","\n","    # Extract initial batch of reviews\n","    google_reviews, continuation_token = reviews(\n","        company_id,\n","        **params\n","    )\n","\n","    # Initialize total reviews list\n","    all_reviews = google_reviews.copy()\n","\n","    # Continue fetching if we need more reviews and have a continuation token\n","    while continuation_token and len(all_reviews) < requested_count:\n","        # Calculate how many more we need\n","        remaining = requested_count - len(all_reviews)\n","\n","        # Update count for next request (max 200 per request)\n","        params['count'] = min(remaining, 200)\n","\n","        # Fetch next batch\n","        next_reviews, continuation_token = reviews(\n","            company_id,\n","            continuation_token=continuation_token,\n","            **params\n","        )\n","\n","        # Add to our collection\n","        all_reviews.extend(next_reviews)\n","\n","    # Ensure we don't exceed requested count\n","    all_reviews = all_reviews[:requested_count]\n","\n","    # Convert to DataFrame\n","    reviews_df = pd.DataFrame(all_reviews)\n","\n","    # Save to CSV if filename provided\n","    if output_filename:\n","        reviews_df.to_csv(output_filename, index=False)\n","\n","    return reviews_df"],"metadata":{"id":"GfKHr4hbirIQ","executionInfo":{"status":"ok","timestamp":1740682058497,"user_tz":480,"elapsed":5,"user":{"displayName":"Aurora Olaya","userId":"17615046577523603944"}}},"execution_count":5,"outputs":[]},{"cell_type":"markdown","source":["## Apple App Store Data Extraction"],"metadata":{"id":"uRdtfEPK0t86"}},{"cell_type":"code","source":["import time\n","import pandas as pd\n","from app_store_scraper import AppStore\n","\n","def extract_apple_reviews(app_name: str, app_id: str = None, output_filename: str = None, **kwargs) -> pd.DataFrame:\n","    \"\"\"\n","    Extract reviews for a given app from Apple App Store and optionally save to CSV.\n","\n","    Args:\n","        app_name: Name of the app\n","        app_id: Unique identifier for the app (optional)\n","        output_filename: Optional filename to save results as CSV\n","        **kwargs: Additional parameters for AppStore scraper\n","            - sleep_milliseconds: Delay between requests (default: 6000)\n","            - country: Country filter (default: 'us')\n","            - how_many: Number of reviews to extract (default: 2000)\n","            - max_retries: Maximum number of retry attempts (default: 5)\n","\n","    Returns:\n","        pandas.DataFrame containing the extracted reviews\n","    \"\"\"\n","    # Set default parameters\n","    default_params = {\n","        'sleep_milliseconds': 20000,\n","        'country': 'us',\n","        'how_many': 2000,\n","        'max_retries': 5\n","    }\n","\n","    # Update defaults with any provided kwargs\n","    params = {**default_params, **kwargs}\n","\n","    # Initialize the scraper\n","    if app_id:\n","        app = AppStore(\n","            country=params['country'],\n","            app_name=app_name,\n","            app_id=app_id\n","        )\n","    else:\n","        # If no app_id provided, initialize with just app_name\n","        app = AppStore(\n","            country=params['country'],\n","            app_name=app_name\n","        )\n","\n","    # Extract reviews with retry logic\n","    retries = 0\n","    while retries <= params['max_retries']:\n","        try:\n","            app.review(\n","                how_many=params['how_many'],\n","                sleep=params['sleep_milliseconds'] / 1000  # convert to seconds\n","            )\n","            break  # Success, exit the loop\n","        except Exception as e:\n","            retries += 1\n","            if retries > params['max_retries']:\n","                raise Exception(f\"Max retries exceeded when extracting reviews for {app_name}\")\n","\n","            wait_time = 2 ** retries  # Exponential backoff\n","            print(f\"Error occurred: {str(e)}. Retrying in {wait_time} seconds...\")\n","            time.sleep(wait_time)\n","\n","    # Convert to DataFrame\n","    reviews_df = pd.DataFrame(app.reviews)\n","\n","    # Add metadata columns\n","    reviews_df['app_name'] = app_name\n","    reviews_df['data_source'] = 'Apple App Store'\n","    reviews_df['reviews_count'] = app.reviews_count\n","\n","    # Save to CSV if filename provided\n","    if output_filename:\n","        reviews_df.to_csv(output_filename, index=False)\n","\n","    return reviews_df"],"metadata":{"id":"Mf_hTlN_0wQ-","executionInfo":{"status":"ok","timestamp":1740682058524,"user_tz":480,"elapsed":25,"user":{"displayName":"Aurora Olaya","userId":"17615046577523603944"}}},"execution_count":6,"outputs":[]},{"cell_type":"markdown","source":["# Extracting Data"],"metadata":{"id":"-1wDXt9Z1nsR"}},{"cell_type":"markdown","source":["# Google App Store"],"metadata":{"id":"7uTMgzDB3a1O"}},{"cell_type":"code","source":["#google app reviews\n","netflix_app_reviews = extract_google_reviews(\"com.netflix.mediaclient\")\n","\n","# Adding company name and data source\n","netflix_app_reviews['company'] = 'Netflix'\n","netflix_app_reviews['data_source'] = 'Google Play'\n","\n","# Preview reviews\n","netflix_app_reviews.head()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","