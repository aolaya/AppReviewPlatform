ch processing to speed up the output results. However, when compared to Michael, 3000 review row entries result in approximately the same time to process.\n","- I looked into emoji sentiment. When analyzing, I see only 6 of the ~700 reviews contained emoji context. From what I see usually the emojis match the context sentiment.\n","- Kept isssues as is based on last communication with Cheryl."],"metadata":{"id":"4fzs5Jjh7t5I"}},{"cell_type":"code","source":["%pip install python-dotenv"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"xu7g1oNXApG1","outputId":"bc4e34b9-07eb-4276-aaf5-9443825db521","executionInfo":{"status":"ok","timestamp":1740682516428,"user_tz":480,"elapsed":3082,"user":{"displayName":"Aurora Olaya","userId":"17615046577523603944"}}},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Collecting python-dotenv\n","  Downloading python_dotenv-1.0.1-py3-none-any.whl.metadata (23 kB)\n","Downloading python_dotenv-1.0.1-py3-none-any.whl (19 kB)\n","Installing collected packages: python-dotenv\n","Successfully installed python-dotenv-1.0.1\n"]}]},{"cell_type":"code","source":["from dotenv import load_dotenv, find_dotenv\n","import os\n","import json\n","import uuid\n","import pandas as pd\n","import re\n","import openai\n","from typing import Dict, Any\n","from openai import OpenAI\n","import time\n"],"metadata":{"id":"WhSI5vsTaTNF"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["## Bring in Clean App Reviews"],"metadata":{"id":"yE8jzCAZgy05"}},{"cell_type":"code","source":["total_review_meaningful_reviews = pd.read_csv('/content/cleaned_streaming_app_reviews (5).csv')"],"metadata":{"id":"lreBfIsyXIvk"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# Preview the data\n","total_review_meaningful_reviews.head()"],"metadata":{"id":"l2LTDSe3chCg","executionInfo":{"status":"ok","timestamp":1740682536865,"user_tz":480,"elapsed":144,"user":{"displayName":"Aurora Olaya